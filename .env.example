# .env.example — Template for your environment variables
#
# HOW TO USE:
#   1. Copy this file:   Copy-Item .env.example .env
#   2. Open .env and replace the placeholder values with your real settings.
#   3. Never commit .env to Git — it contains your secret API key.
#
# WHERE TO GET A GEMINI API KEY:
#   1. Visit https://aistudio.google.com/app/apikey
#   2. Sign in with a Google account (free tier is available)
#   3. Click "Create API key"
#   4. Copy the key and paste it below (in your .env, not here)

# Required: Your Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model to use (default: gemini-2.0-flash)
# Other options: gemini-1.5-pro, gemini-1.5-flash
# gemini-2.0-flash is fast and supports structured JSON output.
GEMINI_MODEL=gemini-2.5-flash

# Optional: Maximum number of attempts including retries (default: 3)
MAX_RETRIES=3

# Optional: Path to the log file (default: agent.log)
LOG_FILE=agent.log
